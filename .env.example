# Copia questo file in .env e completa i valori.

# Token "a lunga durata" di Home Assistant: Profilo utente -> Sicurezza -> Token di accesso a lunga durata
# (server e token si possono impostare anche dall'interfaccia web: Impostazioni)
HA_URL=http://127.0.0.1:8123
HA_TOKEN=INSERISCI_QUI_IL_TOKEN_HA

# con podman-compose HA_URL e INFLUX_URL sono impostati in docker-compose.yml
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=casa
INFLUX_BUCKET=energia
# genera valori casuali, es: openssl rand -hex 16 / openssl rand -hex 32
INFLUX_PASSWORD=CAMBIAMI
INFLUX_TOKEN=CAMBIAMI

# Opzionali
INTERVAL_SECONDS=900
LOOKBACK_HOURS=6
# EXTRA_STATISTIC_IDS=sensor.altro_contatore_kwh
# FORCE_BACKFILL=true
# BACKUP_KEEP=10
# WEB_PORT=8090   # porta pubblicata sull'host per la dashboard

# Auto elettrica - lasciare vuoto per disattivare la sezione Auto
AUTO_ENERGY_ID=
AUTO_ODOMETER_ID=
AUTO_BATTERY_ID=
AUTO_POWER_ID=
AUTO_HOME_ID=
